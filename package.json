{
  "name": "kazuji-media",
  "version": "1.2.2",
  "private": true,
  "description": "Agregador de streams para Nuvio e Stremio",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build-badges.js && node scripts/build.js",
    "build:badges": "node scripts/build-badges.js",
    "render:badges": "python3 scripts/render-badge-pngs.py",
    "check:badge-images": "python3 scripts/check-badge-images.py",
    "test": "node --test test/*.test.js",
    "check": "node scripts/build-badges.js --check && node scripts/build.js --check",
    "start": "node src/server.js"
  }
}
